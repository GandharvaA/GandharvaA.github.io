<button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
  <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const media = matchMedia('(prefers-color-scheme: dark)');

  const label = () => {
    if (!button) return;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    button.setAttribute('aria-label', `Switch to ${next} theme`);
  };

  const apply = (theme: string, persist: boolean) => {
    root.dataset.theme = theme;
    if (persist) {
      try {
        localStorage.setItem('theme', theme);
      } catch {}
    }
    label();
  };

  button?.addEventListener('click', () => apply(root.dataset.theme === 'dark' ? 'light' : 'dark', true));

  media.addEventListener('change', (e) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {}
    if (!stored) apply(e.matches ? 'dark' : 'light', false);
  });

  label();
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    flex: none;
  }
  .theme-toggle:hover {
    border-color: var(--ink-soft);
  }
  .theme-toggle svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .icon-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: block;
  }
  @media print {
    .theme-toggle {
      display: none;
    }
  }
</style>
