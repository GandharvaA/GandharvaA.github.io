  <circle class="surface stroke d2" pathLength="1" cx="392" cy="126" r="26" />

  <text class="glyph fade d2" x="84" y="134" text-anchor="middle">Λ</text>
  <text class="glyph fade d2" x="176" y="134" text-anchor="middle">Λ</text>
  <text class="glyph fade d2" x="300" y="134" text-anchor="middle">Λ</text>
  <text class="glyph fade d2" x="392" y="134" text-anchor="middle">Λ</text>

