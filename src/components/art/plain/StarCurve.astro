<svg class="draw star-curve" viewBox="0 0 540 300" role="img" aria-labelledby="sc-title sc-desc">
  <title id="sc-title">A neutron star, and the heaviest mass it can support with a push or a pull between lambdas</title>
  <desc id="sc-desc">
    On the left a small circle stands for a neutron star, with a darker core and a dashed radius. On
    the right a small graph shows how much mass a star can support as its size grows. A dashed
    horizontal line marks the heaviest stars astronomers observe. If the lambdas push apart the matter
    stays stiff, the upper curve clears that line and heavy stars are allowed. If they pull together
    the matter softens, and the lower curve turns over beneath the line. A sketch, not a measured
    curve.
  </desc>

  <circle class="surface stroke d1" pathLength="1" cx="104" cy="152" r="38" />
  <path class="core fade d2" d="M104 126 A26 26 0 0 0 104 178 Z" />
  <circle class="inner stroke d2" pathLength="1" cx="104" cy="152" r="14" />
  <path class="radius stroke d3" pathLength="1" d="M104 152 H142" />
  <text class="anno fade d3" x="104" y="212" text-anchor="middle">a city-sized</text>
  <text class="anno fade d3" x="104" y="228" text-anchor="middle">ball of neutrons</text>

  <path class="frame stroke d3" pathLength="1" d="M214 54 V250 H382" />

  <path class="observed fade d4" d="M214 106 H382" />
  <text class="anno fade d4" x="220" y="99">stars we observe</text>

  <path class="stiff stroke d5" pathLength="1" d="M222 240 C 240 160, 256 104, 276 96 C 298 88, 322 128, 376 176" />
  <path class="soft stroke d6" pathLength="1" d="M222 240 C 238 196, 250 168, 264 162 C 280 156, 302 186, 376 232" />

  <g class="fade d7">
    <text class="label-repel" x="392" y="166">repulsion</text>
    <text class="anno" x="392" y="180">stiffer matter</text>
    <text class="label-attract" x="392" y="222">attraction</text>
    <text class="anno" x="392" y="236">softer matter</text>
  </g>

  <g class="fade d8">
    <text class="anno" x="204" y="58" text-anchor="end">mass</text>
    <text class="anno" x="378" y="268" text-anchor="end">size</text>
  </g>
</svg>

