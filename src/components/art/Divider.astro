---
interface Props {
  label?: string;
}
const { label } = Astro.props;
---

<div class="divider" role="presentation">
  <span class="rule"></span>
  <svg viewBox="0 0 96 24" aria-hidden="true">
    <path d="M0 12h22" class="tick" />
    <path d="M30 18 A 22 22 0 0 1 66 6" class="arc" />
    <circle cx="38" cy="12.6" r="1.8" class="hit" />
    <circle cx="48" cy="8.4" r="1.8" class="hit" />
    <circle cx="58" cy="6.6" r="1.8" class="hit" />
    <path d="M74 12h22" class="tick" />
  </svg>
  {label && <span class="divider-label">{label}</span>}
  <span class="rule"></span>
</div>

<style>
  .divider {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink-soft);
  }
  .rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  svg {
    width: 5.5rem;
    height: 1.5rem;
    fill: none;
    stroke: var(--art);
    stroke-width: 1.1;
    stroke-linecap: round;
  }
  .tick {
    stroke-dasharray: 1 3;
  }
  .arc {
    stroke: var(--art-accent);
    stroke-width: 1.5;
  }
  .hit {
    fill: var(--paper);
  }
  .divider-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
