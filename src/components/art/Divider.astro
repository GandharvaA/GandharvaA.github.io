---
interface Props {
  label?: string;
}
const { label } = Astro.props;
---

<div class="divider" role="presentation">
  <span class="rule"></span>
  <svg viewBox="0 0 160 58" aria-hidden="true">
    <path d="M0 42H22" class="tick" />
    <path d="M26 46C48 46 62 20 80 16C98 12 112 28 134 44" class="arc" />
    <g class="ns">
      <circle class="surface" cx="80" cy="18" r="13" />
      <path class="core" d="M80 7.1A10.9 10.9 0 0 0 80 28.9Z" />
      <circle class="inner" cx="80" cy="18" r="4.6" />
    </g>
    <path d="M138 42H160" class="tick" />
  </svg>
  {label && <span class="divider-label">{label}</span>}
  <span class="rule"></span>
</div>

<style>
  .divider {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--ink-soft);
  }
  .rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  svg {
    width: 9rem;
    height: 3.25rem;
    fill: none;
    stroke: var(--art);
    stroke-width: 1.1;
    stroke-linecap: round;
    overflow: visible;
  }
  .tick {
    stroke-dasharray: 1 3;
  }
  .arc {
    stroke: var(--art-accent);
    stroke-width: 1.6;
  }
  .surface {
    fill: var(--paper);
    stroke: var(--art);
    stroke-width: 1.2;
  }
  .core {
    fill: var(--art-accent);
    stroke: none;
  }
  .inner {
    fill: none;
    stroke: var(--art);
    stroke-width: 1.1;
  }
  .divider-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
