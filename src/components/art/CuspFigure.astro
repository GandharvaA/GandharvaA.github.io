---
const x0 = 70, x1 = 610, y0 = 300, y1 = 40;
const mMin = 2.228, mMax = 2.3;
const thLL = 2.2314, thXi0n = 2.2544, thXim = 2.26;
const r1 = (n: number) => Math.round(n * 10) / 10;
const X = (m: number) => x0 + ((m - mMin) / (mMax - mMin)) * (x1 - x0);

const base = (m: number) => {
  if (m <= thLL) return 0;
  const dm = m - thLL;
  return (Math.sqrt(dm) / (1 + dm / 0.022)) * (1 + 0.6 / (1 + (dm / 0.005) ** 2));
};
const cusp = (m: number, th: number, h: number) => h * base(th) * Math.exp(-Math.sqrt(Math.abs(m - th)) / 0.035);
const full = (m: number) => (m <= thLL ? 0 : base(m) + cusp(m, thXi0n, 0.5) + cusp(m, thXim, 0.4));

const N = 360;
const ms = Array.from({ length: N + 1 }, (_, i) => mMin + (i / N) * (mMax - mMin));
const fv = ms.map(full);
const bv = ms.map(base);
const sigma = 0.0022;
const smeared = ms.map((m) => {
  let s = 0, w = 0;
  for (let j = 0; j < ms.length; j++) {
    const k = Math.exp(-((ms[j] - m) ** 2) / (2 * sigma * sigma));
    s += k * fv[j];
    w += k;
  }
  return s / w;
});
const ymax = Math.max(...fv) * 1.12;
const Y = (v: number) => y0 - (v / ymax) * (y0 - y1);
const line = (vals: number[]) => 'M' + vals.map((v, i) => `${r1(X(ms[i]))} ${r1(Y(v))}`).join('L');

const ticks = [2.23, 2.24, 2.25, 2.26, 2.27, 2.28, 2.29, 2.3];
---

<svg class="cusp-fig draw" viewBox="0 0 640 360" role="img" aria-labelledby="cusp-title cusp-desc">
  <title id="cusp-title">Schematic ΛΛ invariant-mass spectrum with cusps at the ΞN thresholds</title>
  <desc id="cusp-desc">
    Illustrative curves, not data. The ΛΛ invariant-mass distribution rises from the ΛΛ threshold. Where the
    coupled Ξ⁰n and Ξ⁻p channels open, the spectrum shows sharp cusp structures. A dashed curve shows the
    spectrum without channel coupling, and a smoother curve shows how finite detector resolution washes the
    cusps out.
  </desc>

  <g class="axes fade d1">
    <path class="axis" d={`M${x0} ${y1 - 10}V${y0}H${x1 + 10}`} />
    {ticks.map((t) => (
      <g>
        <path class="tick" d={`M${r1(X(t))} ${y0}v5`} />
        <text class="tick-label" x={r1(X(t))} y={y0 + 20} text-anchor="middle">{t.toFixed(2)}</text>
      </g>
    ))}
    <text class="axis-label" x={x1} y={y0 + 42} text-anchor="end">M(ΛΛ) [GeV/c²]</text>
    <text class="axis-label" x="16" y={y1 - 16}>dσ/dM (arb. units)</text>
  </g>

  <g class="thresholds fade d2">
    {[
      { m: thLL, label: 'ΛΛ', dy: 0 },
      { m: thXi0n, label: 'Ξ⁰n', dy: 0 },
      { m: thXim, label: 'Ξ⁻p', dy: 14 },
    ].map((t) => (
      <g>
        <path class="thr" d={`M${r1(X(t.m))} ${y0}V${y1 + 6}`} />
        <text class="thr-label" x={r1(X(t.m)) + 5} y={y1 + 14 + t.dy}>{t.label}</text>
      </g>
    ))}
  </g>

  <path class="no-coupling fade d4" d={line(bv)} />
  <path class="smeared stroke d5" pathLength="1" d={line(smeared)} />
  <path class="truth stroke d3" pathLength="1" d={line(fv)} />

  <g class="legend fade d6">
    <path class="truth" d="M400 222h28" />
    <text class="legend-label" x="436" y="226">coupled channels (cusps)</text>
    <path class="no-coupling" d="M400 244h28" />
    <text class="legend-label" x="436" y="248">no coupling</text>
    <path class="smeared" d="M400 266h28" />
    <text class="legend-label" x="436" y="270">after detector resolution</text>
    <text class="legend-note" x="610" y="20" text-anchor="end">schematic, not data</text>
  </g>
</svg>

<style>
  .cusp-fig {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .cusp-fig :is(path) {
    fill: none;
  }
  .axis,
  .tick {
    stroke: var(--art);
    stroke-width: 1.1;
  }
  .tick-label,
  .axis-label,
  .thr-label,
  .legend-label,
  .legend-note {
    font-family: var(--font-mono);
    font-size: 11.5px;
    fill: var(--ink-soft);
  }
  .thr-label {
    fill: var(--ink);
    font-weight: 600;
  }
  .legend-note {
    font-size: 10.5px;
    font-style: italic;
  }
  .thr {
    stroke: var(--art);
    stroke-width: 0.8;
    stroke-dasharray: 2 4;
    opacity: 0.7;
  }
  .truth {
    stroke: var(--art-accent);
    stroke-width: 2;
  }
  .no-coupling {
    stroke: var(--art);
    stroke-width: 1.2;
    stroke-dasharray: 5 4;
    opacity: 0.8;
  }
  .smeared {
    stroke: var(--accent-2);
    stroke-width: 1.8;
  }
</style>
