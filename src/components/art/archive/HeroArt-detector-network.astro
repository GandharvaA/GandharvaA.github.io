---
/**
 * Saved Fig. 1, October 2026. Detector tracks feed a small classifier, then a
 * one-dimensional mass fit. Not imported anywhere. Restore by copying this file
 * back over HeroArt.astro.
 */
type Pt = [number, number];
const C: Pt = [232, 262];
const rings = [44, 74, 98, 122, 146];
const rOut = 186;
const r1 = (n: number) => Math.round(n * 10) / 10;
const dist = (p: Pt) => Math.hypot(p[0] - C[0], p[1] - C[1]);
const polar = (r: number, deg: number): Pt => {
  const a = (deg * Math.PI) / 180;
  return [C[0] + r * Math.cos(a), C[1] + r * Math.sin(a)];
};

function track(start: Pt, phiDeg: number, R: number, q: 1 | -1, rMax = rOut - 8) {
  const phi = (phiDeg * Math.PI) / 180;
  const O: Pt = [start[0] - q * R * Math.sin(phi), start[1] + q * R * Math.cos(phi)];
  const th0 = Math.atan2(start[1] - O[1], start[0] - O[0]);
  const pts: Pt[] = [start];
  const hits: Pt[] = [];
  let prev = start;
  for (let s = 2; s < 600; s += 2) {
    const th = th0 + (q * s) / R;
    const p: Pt = [O[0] + R * Math.cos(th), O[1] + R * Math.sin(th)];
    for (const r of rings) {
      const a = dist(prev) - r;
      const b = dist(p) - r;
      if (a < 0 && b >= 0) {
        const t = a / (a - b);
        hits.push([prev[0] + t * (p[0] - prev[0]), prev[1] + t * (p[1] - prev[1])]);
      }
    }
    pts.push(p);
    prev = p;
    if (dist(p) >= rMax) break;
  }
  const d = 'M' + pts.map((p) => `${r1(p[0])} ${r1(p[1])}`).join('L');
  return { d, hits, end: pts[pts.length - 1] };
}

const primaries = [
  { phi: -150, R: 150, q: 1 as const },
  { phi: -100, R: 108, q: -1 as const },
  { phi: -48, R: 260, q: 1 as const },
  { phi: 76, R: 125, q: 1 as const },
  { phi: 128, R: 210, q: -1 as const },
  { phi: 196, R: 112, q: -1 as const },
].map((t) => track(C, t.phi, t.R, t.q));

const vertex = polar(58, 8);
const lambdaDecay = [
  { ...track(vertex, -6, 520, 1), cls: 'proton' },
  { ...track(vertex, 34, 140, -1), cls: 'pion' },
];

const spokes = [30, 90, 150, 210, 270, 330];

const band: string[] = [];
for (let k = 0; k < 40; k++) {
  const a0 = (k * 9 + 0.9) * (Math.PI / 180);
  const a1 = ((k + 1) * 9 - 0.9) * (Math.PI / 180);
  const r = 172;
  band.push(
    `M${r1(C[0] + r * Math.cos(a0))} ${r1(C[1] + r * Math.sin(a0))}A${r} ${r} 0 0 1 ${r1(C[0] + r * Math.cos(a1))} ${r1(C[1] + r * Math.sin(a1))}`,
  );
}

const layers = [
  { x: 506, ys: [150, 196, 242, 288] },
  { x: 584, ys: [128, 172, 216, 260, 304] },
  { x: 662, ys: [186, 236] },
];
const edges: string[] = [];
for (let l = 0; l < layers.length - 1; l++) {
  for (const y0 of layers[l].ys) {
    for (const y1 of layers[l + 1].ys) edges.push(`M${layers[l].x} ${y0}L${layers[l + 1].x} ${y1}`);
  }
}
const feedSources = [-34, -14, 6, 26].map((a) => polar(rOut + 4, a));
const feeds = feedSources.map((p, i) => `M${r1(p[0])} ${r1(p[1])}C${r1(p[0] + 60)} ${r1(p[1])} ${440} ${layers[0].ys[i]} ${layers[0].x - 8} ${layers[0].ys[i]}`);

const hx0 = 470, hx1 = 712, hy0 = 470, hBins = 22;
const bw = (hx1 - hx0) / hBins;
const counts = Array.from({ length: hBins }, (_, i) => {
  const x = (i + 0.5) / hBins;
  const bg = 46 * Math.sqrt(x) * Math.exp(-1.6 * x) + 6;
  const sig = 30 * Math.exp(-((x - 0.5) ** 2) / (2 * 0.045 ** 2));
  const wiggle = [2, -3, 1, 3, -2, 0, 2, -1, -3, 1, 0, 2, -2, 1, 3, -1, 0, -2, 2, 1, -1, 0][i];
  return Math.max(2, bg + sig + wiggle);
});
const yScale = 1.65;
let hist = `M${hx0} ${hy0}`;
counts.forEach((c, i) => {
  const y = r1(hy0 - c * yScale);
  hist += `V${y}H${r1(hx0 + (i + 1) * bw)}`;
});
hist += `V${hy0}`;
const fitPts: string[] = [];
for (let k = 0; k <= 120; k++) {
  const x = k / 120;
  const bg = 46 * Math.sqrt(x) * Math.exp(-1.6 * x) + 6;
  const sig = 30 * Math.exp(-((x - 0.5) ** 2) / (2 * 0.045 ** 2));
  fitPts.push(`${r1(hx0 + x * (hx1 - hx0))} ${r1(hy0 - (bg + sig) * yScale)}`);
}
const fit = 'M' + fitPts.join('L');
const bgPts: string[] = [];
for (let k = 0; k <= 60; k++) {
  const x = k / 60;
  const bg = 46 * Math.sqrt(x) * Math.exp(-1.6 * x) + 6;
  bgPts.push(`${r1(hx0 + x * (hx1 - hx0))} ${r1(hy0 - bg * yScale)}`);
}
const bgCurve = 'M' + bgPts.join('L');
const sx = (x: number) => r1(hx0 + x * (hx1 - hx0));
---

<svg class="hero-art draw" viewBox="0 0 740 520" role="img" aria-labelledby="hero-art-title hero-art-desc">
  <title id="hero-art-title">Detector cross-section feeding a neural network</title>
  <desc id="hero-art-desc">
    Line drawing of a six-sector particle detector seen along the beam axis. Charged-particle tracks curve in the
    magnetic field and leave hits in the detector layers; a neutral Lambda hyperon decays into a proton and a pion.
    The hits feed a small neural network whose output is an invariant-mass histogram with a signal peak on top of
    background.
  </desc>

  <g class="detector">
    {spokes.map((a) => { const p0 = polar(30, a); const p1 = polar(rOut + 6, a); return <line class="spoke stroke d1" pathLength="1" x1={r1(p0[0])} y1={r1(p0[1])} x2={r1(p1[0])} y2={r1(p1[1])} />; })}
    <circle class="ring inner stroke d1" pathLength="1" cx={C[0]} cy={C[1]} r={rings[0]} />
    {rings.slice(1).map((r) => <circle class="ring mdc fade d2" cx={C[0]} cy={C[1]} r={r} />)}
    <g class="band fade d3">{band.map((d) => <path d={d} />)}</g>
    <circle class="ring outer stroke d2" pathLength="1" cx={C[0]} cy={C[1]} r={rOut} />
    <circle class="beam" cx={C[0]} cy={C[1]} r="3.2" />
    <circle class="beam-ring" cx={C[0]} cy={C[1]} r="7" />
  </g>

  <g class="tracks">
    {primaries.map((t, i) => <path class:list={['track stroke', `d${3 + (i % 4)}`]} pathLength="1" d={t.d} />)}
    <line class="neutral fade d4" x1={C[0]} y1={C[1]} x2={r1(vertex[0])} y2={r1(vertex[1])} />
    {lambdaDecay.map((t) => <path class:list={['track decay stroke d5', t.cls]} pathLength="1" d={t.d} />)}
    <circle class="vertex fade d5" cx={r1(vertex[0])} cy={r1(vertex[1])} r="3" />
  </g>
  <g class="hits fade d6">
    {primaries.flatMap((t) => t.hits).map((h) => <circle class="hit" cx={r1(h[0])} cy={r1(h[1])} r="2.3" />)}
    {lambdaDecay.flatMap((t) => t.hits).map((h) => <circle class="hit hot" cx={r1(h[0])} cy={r1(h[1])} r="2.6" />)}
  </g>

  <g class="annotations fade d7">
    <text class="anno" x={C[0] - 62} y="50">B ⊙ magnetic field</text>
    <text class="anno accent" x={r1(vertex[0]) - 8} y={r1(vertex[1]) - 12}>Λ → p π⁻</text>
    <text class="anno" x="22" y="470">tracking layers · timing wall</text>
    <text class="anno" x="22" y="486">beam axis into the page</text>
  </g>

  <g class="network">
    {feeds.map((d) => <path class="feed fade d6" d={d} />)}
    {edges.map((d) => <path class="edge fade d7" d={d} />)}
    {layers.map((l, li) => l.ys.map((y) => <circle class:list={['node fade d7', li === 2 && 'out']} cx={l.x} cy={y} r="8" />))}
    <text class="anno" x="490" y="98">features</text>
    <text class="anno" x="566" y="98">hidden</text>
    <text class="anno" x="642" y="98">classifier</text>
    <text class="node-label" x="676" y="190">S</text>
    <text class="node-label" x="676" y="240">B</text>
  </g>

  <g class="plot">
    <rect class="sideband fade d7" x={sx(0.18)} y={hy0 - 118} width={sx(0.34) - sx(0.18)} height="118" />
    <rect class="sideband fade d7" x={sx(0.66)} y={hy0 - 118} width={sx(0.82) - sx(0.66)} height="118" />
    <rect class="window fade d7" x={sx(0.43)} y={hy0 - 118} width={sx(0.57) - sx(0.43)} height="118" />
    <path class="axis stroke d6" pathLength="1" d={`M${hx0} ${hy0 - 124}V${hy0}H${hx1 + 6}`} />
    <path class="hist stroke d7" pathLength="1" d={hist} />
    <path class="bg-curve fade d8" d={bgCurve} />
    <path class="fit stroke d8" pathLength="1" d={fit} />
    <text class="anno" x={hx1 + 6} y={hy0 + 18} text-anchor="end">m(pπ⁻)</text>
    <text class="anno small" x={sx(0.26)} y={hy0 - 124} text-anchor="middle">side</text>
    <text class="anno small" x={sx(0.5)} y={hy0 - 124} text-anchor="middle">signal</text>
    <text class="anno small" x={sx(0.74)} y={hy0 - 124} text-anchor="middle">side</text>
    <path class="arrow fade d7" d="M662 262 C 670 300, 640 330, 612 344" />
    <path class="arrow-head fade d7" d="M612 344 l 9 -1 M612 344 l 4 -8" />
  </g>
</svg>

<style>
  .hero-art {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .spoke {
    stroke: var(--art);
    stroke-width: 0.8;
    opacity: 0.45;
  }
  .ring {
    fill: none;
    stroke: var(--art);
    stroke-width: 1.1;
  }
  .mdc {
    stroke-dasharray: 2 3;
    opacity: 0.7;
  }
  .outer {
    stroke-width: 1.3;
  }
  .band path {
    fill: none;
    stroke: var(--art);
    stroke-width: 11;
    opacity: 0.13;
  }
  .beam {
    fill: var(--art);
  }
  .beam-ring {
    fill: none;
    stroke: var(--art);
    stroke-width: 1;
  }
  .track {
    fill: none;
    stroke: var(--art);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .decay {
    stroke: var(--art-accent);
    stroke-width: 2;
  }
  .neutral {
    stroke: var(--art-accent);
    stroke-width: 1.4;
    stroke-dasharray: 3 4;
  }
  .vertex {
    fill: var(--paper);
    stroke: var(--art-accent);
    stroke-width: 1.5;
  }
  .hit {
    fill: var(--paper);
    stroke: var(--art);
    stroke-width: 1.2;
  }
  .hit.hot {
    fill: var(--art-accent);
    stroke: var(--art-accent);
  }
  .anno,
  .node-label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    fill: var(--ink-soft);
    letter-spacing: 0.02em;
  }
  .anno.small {
    font-size: 10px;
  }
  .anno.accent {
    fill: var(--art-accent);
    font-weight: 600;
  }
  .node-label {
    fill: var(--ink);
    font-weight: 600;
  }
  .leader {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 0.8;
  }
  .feed {
    fill: none;
    stroke: var(--art);
    stroke-width: 1;
    stroke-dasharray: 2 3;
    opacity: 0.75;
  }
  .edge {
    fill: none;
    stroke: var(--art);
    stroke-width: 0.7;
    opacity: 0.35;
  }
  .node {
    fill: var(--paper);
    stroke: var(--art);
    stroke-width: 1.4;
  }
  .node.out {
    stroke: var(--art-accent);
    stroke-width: 1.8;
  }
  .axis {
    fill: none;
    stroke: var(--art);
    stroke-width: 1.1;
  }
  .hist {
    fill: none;
    stroke: var(--art);
    stroke-width: 1.2;
  }
  .fit {
    fill: none;
    stroke: var(--art-accent);
    stroke-width: 2;
  }
  .bg-curve {
    fill: none;
    stroke: var(--accent-2);
    stroke-width: 1.4;
    stroke-dasharray: 4 3;
  }
  .sideband {
    fill: var(--accent-2);
    opacity: 0.1;
  }
  .window {
    fill: var(--art-accent);
    opacity: 0.1;
  }
  .arrow,
  .arrow-head {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 1;
    stroke-linecap: round;
  }
</style>
