---
const r1 = (n: number) => Math.round(n * 10) / 10;
const OX = 78;
const OY = 18;
const S = 210;
const N = 10;
const cell = S / N;

const intensity = (i: number, j: number) => {
  const x = (i + 0.5) / N;
  const y = (j + 0.5) / N;
  const comb = 0.32 * Math.exp(-1.35 * (x + y));
  const peak = Math.exp(-((x - 0.5) ** 2 + (y - 0.5) ** 2) / (2 * 0.028 ** 2));
  return Math.min(1, comb + 0.05 + peak);
};

const cells = Array.from({ length: N }, (_, i) =>
  Array.from({ length: N }, (_, j) => {
    const v = intensity(i, j);
    return {
      x: r1(OX + i * cell + 1),
      y: r1(OY + (N - 1 - j) * cell + 1),
      v,
      hot: v > 0.5,
    };
  }),
).flat().filter((c) => c.v > 0.16);

const band = (x0: number, x1: number, y0: number, y1: number) => ({
  x: r1(OX + x0 * S),
  y: r1(OY + (1 - y1) * S),
  w: r1((x1 - x0) * S),
  h: r1((y1 - y0) * S),
});
const signal = band(0.4, 0.6, 0.4, 0.6);
const sidebands = [
  band(0.24, 0.36, 0.4, 0.6),
  band(0.64, 0.76, 0.4, 0.6),
  band(0.4, 0.6, 0.24, 0.36),
  band(0.4, 0.6, 0.64, 0.76),
];

const hx = OX + S / 2;
const hy = OY + S / 2;
const ellipse = (rx: number, ry: number) => {
  const pts: string[] = [];
  for (let k = 0; k <= 64; k++) {
    const a = (k / 64) * Math.PI * 2;
    pts.push(`${r1(hx + rx * Math.cos(a))} ${r1(hy + ry * Math.sin(a))}`);
  }
  return `M${pts.join('L')}Z`;
};

const fx = 36;
const fy = 500;
const fw = 200;
const fh = 168;
const pt = (radius: number, massY: number) => `${r1(fx + radius * fw)} ${r1(fy + (1 - massY) * fh)}`;
const stiff = `M ${pt(0.1, 0.1)} C ${pt(0.24, 0.16)}, ${pt(0.38, 0.6)}, ${pt(0.52, 0.9)} C ${pt(0.64, 0.98)}, ${pt(0.76, 0.68)}, ${pt(0.92, 0.36)}`;
const soft = `M ${pt(0.14, 0.08)} C ${pt(0.32, 0.14)}, ${pt(0.46, 0.4)}, ${pt(0.58, 0.58)} C ${pt(0.7, 0.62)}, ${pt(0.82, 0.4)}, ${pt(0.94, 0.18)}`;
const massLine = r1(fy + 0.2 * fh);

const stars = [
  { x: 330, y: 528, r: 34 },
  { x: 358, y: 640, r: 42 },
];
---

<svg class="quote-art" viewBox="0 0 430 710" role="img" aria-labelledby="quote-art-title quote-art-desc">
  <title id="quote-art-title">From the ΛΛ masses to the neutron star</title>
  <desc id="quote-art-desc">
    A two-dimensional histogram of the two proton-pion candidate masses, with the ΛΛ signal where both
    sit at the Λ mass. Two Λ hyperons attract, and a schematic potential falls below the line of no
    interaction. That attraction feeds two mass-radius curves and two neutron stars. The upper star
    meets the observed two-solar-mass line. The lower curve turns over beneath it. The potential is a
    sketch, not a measured curve.
  </desc>

  <rect class="frame stroke d1" pathLength="1" x={OX} y={OY} width={S} height={S} />
  {cells.map((c) => (
    <rect class:list={['cell fade d2', c.hot && 'hot']} x={c.x} y={c.y} width={r1(cell - 2.4)} height={r1(cell - 2.4)} opacity={c.hot ? 0.9 : r1(0.14 + c.v * 0.4)} />
  ))}
  {sidebands.map((b) => <rect class="sideband fade d3" x={b.x} y={b.y} width={b.w} height={b.h} />)}
  <rect class="window fade d3" x={signal.x} y={signal.y} width={signal.w} height={signal.h} />
  <path class="fit-wide fade d4" d={ellipse(0.14 * S, 0.13 * S)} />
  <path class="fit stroke d4" pathLength="1" d={ellipse(0.08 * S, 0.072 * S)} />
  <g class="fade d4">
    <text class="anno" x={OX + S} y={OY + S + 18} text-anchor="end">m(pπ⁻)₁</text>
    <text class="anno" x="52" y={hy} text-anchor="middle" transform={`rotate(-90 52 ${hy})`}>m(pπ⁻)₂</text>
    <text class="mark" x={hx} y={hy - 22} text-anchor="middle">ΛΛ</text>
  </g>

  <path class="feed hot stroke d5" pathLength="1" d={`M${hx} ${OY + S + 8} V276`} />

  <g class="fade d5">
    <circle class="particle" cx="130" cy="300" r="16" />
    <text class="lambda" x="130" y="305" text-anchor="middle">Λ</text>
    <circle class="particle" cx="300" cy="300" r="16" />
    <text class="lambda" x="300" y="305" text-anchor="middle">Λ</text>
  </g>
  <path class="arrow stroke d6" pathLength="1" d="M152 300 H206" />
  <path class="arrow stroke d6" pathLength="1" d="M206 300 l-9 -5 M206 300 l-9 5" />
  <path class="arrow stroke d6" pathLength="1" d="M278 300 H224" />
  <path class="arrow stroke d6" pathLength="1" d="M224 300 l9 -5 M224 300 l9 5" />

  <path class="zero fade d6" d="M96 352 H340" />
  <g class="fade d6">
    <text class="anno" x="346" y="356">V = 0</text>
    <text class="anno" x="78" y="410" text-anchor="middle" transform="rotate(-90 78 410)">V(r)</text>
  </g>
  <path class="well fade d7" d="M118 352 C 155 352, 168 446, 215 448 C 262 450, 275 352, 312 352" />
  <path class="well-line stroke d7" pathLength="1" d="M118 352 C 155 352, 168 446, 215 448 C 262 450, 275 352, 312 352" />
  <g class="fade d7">
    <text class="mark" x="215" y="418" text-anchor="middle">ΛΛ attraction</text>
    <text class="anno" x="215" y="478" text-anchor="middle">distance between the Λs</text>
  </g>

  <path class="feed hot stroke d7" pathLength="1" d="M215 470 V498" />

  <rect class="frame stroke d7" pathLength="1" x={fx} y={fy} width={fw} height={fh} />
  <path class="zero fade d8" d={`M${fx} ${massLine} H${fx + fw}`} />
  <g class="fade d8">
    <text class="anno" x={fx + 8} y={massLine - 8}>2 M☉</text>
    <text class="anno" x={fx - 8} y={fy + 14} text-anchor="end">M</text>
    <text class="anno" x={fx + fw} y={fy + fh + 18} text-anchor="end">R</text>
  </g>
  <path class="stiff stroke d8" pathLength="1" d={stiff} />
  <path class="soft stroke d8" pathLength="1" d={soft} />

  <path class="feed stroke d8" pathLength="1" d={`M${pt(0.54, 0.92)} C 280 512, 300 516, 318 522`} />
  <path class="feed hot stroke d8" pathLength="1" d={`M${pt(0.62, 0.55)} C 290 600, 318 618, 332 628`} />

  {stars.map((s) => {
    const crust = s.r * 0.84;
    const inner = s.r * 0.36;
    return (
      <g>
        <circle class="surface stroke d8" pathLength="1" cx={s.x} cy={s.y} r={s.r} />
        <path class="core fade d8" d={`M ${s.x} ${r1(s.y - crust)} A ${r1(crust)} ${r1(crust)} 0 0 0 ${s.x} ${r1(s.y + crust)} Z`} />
        <circle class="inner stroke d8" pathLength="1" cx={s.x} cy={s.y} r={r1(inner)} />
        <path class="radius stroke d8" pathLength="1" d={`M ${s.x} ${s.y} H ${s.x + s.r}`} />
      </g>
    );
  })}
</svg>

<style>
  .quote-art {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .frame,
  .particle,
  .surface {
    fill: var(--paper);
    stroke: var(--art);
    stroke-width: 1.35;
  }
  .frame {
    fill: none;
  }
  .cell {
    fill: var(--art);
  }
  .cell.hot {
    fill: var(--art-accent);
  }
  .sideband {
    fill: var(--accent-2);
    opacity: 0.2;
  }
  .window {
    fill: var(--art-accent);
    opacity: 0.16;
  }
  .fit,
  .fit-wide,
  .feed,
  .arrow,
  .zero,
  .stiff,
  .soft,
  .radius,
  .inner {
    fill: none;
    stroke-linecap: round;
  }
  .fit,
  .soft,
  .arrow,
  .feed.hot {
    stroke: var(--art-accent);
  }
  .fit,
  .soft,
  .stiff {
    stroke-width: 1.8;
  }
  .fit-wide {
    stroke: var(--art-accent);
    stroke-width: 1.2;
    stroke-dasharray: 4 3;
  }
  .feed,
  .stiff,
  .radius,
  .inner {
    stroke: var(--art);
    stroke-width: 1.3;
  }
  .feed {
    opacity: 0.7;
  }
  .feed.hot {
    opacity: 1;
  }
  .arrow {
    stroke-width: 2.2;
  }
  .zero {
    stroke: var(--ink-soft);
    stroke-width: 1.1;
    stroke-dasharray: 4 3.5;
  }
  .well {
    fill: var(--art-accent);
    fill-opacity: 0.3;
    stroke: none;
  }
  .well-line {
    fill: none;
    stroke: var(--art-accent);
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .core {
    fill: var(--art-accent);
    stroke: none;
  }
  .anno,
  .lambda,
  .mark {
    font-family: var(--font-mono);
    fill: var(--ink-soft);
  }
  .anno {
    font-size: 13px;
  }
  .lambda {
    font-size: 16px;
    fill: var(--art);
  }
  .mark {
    font-size: 14px;
    fill: var(--accent-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .quote-art:not(.inview) .stroke {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    .quote-art:not(.inview) .fade {
      opacity: 0;
    }
    .quote-art.inview .stroke {
      animation: draw-on 1.6s cubic-bezier(0.55, 0.1, 0.25, 1) forwards;
    }
    .quote-art.inview .fade {
      animation: fade-in 0.8s ease both;
    }
    .quote-art.inview .d1 { animation-delay: 0.15s; }
    .quote-art.inview .d2 { animation-delay: 0.35s; }
    .quote-art.inview .d3 { animation-delay: 0.6s; }
    .quote-art.inview .d4 { animation-delay: 0.85s; }
    .quote-art.inview .d5 { animation-delay: 1.1s; }
    .quote-art.inview .d6 { animation-delay: 1.35s; }
    .quote-art.inview .d7 { animation-delay: 1.6s; }
    .quote-art.inview .d8 { animation-delay: 1.9s; }
  }
</style>

<script is:inline>
  (function () {
    var art = document.querySelector('.quote-art');
    if (!art) return;
    var start = function () { art.classList.add('inview'); };
    var check = function () {
      var box = art.getBoundingClientRect();
      var line = window.innerHeight * 0.45;
      if (box.top < line && box.bottom > 80) {
        start();
        window.removeEventListener('scroll', check);
      }
    };
    check();
    window.addEventListener('scroll', check, { passive: true });
  })();
</script>
