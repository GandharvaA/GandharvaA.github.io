---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['monogram', className]} viewBox="0 0 40 40" aria-hidden="true">
  <circle cx="20" cy="20" r="18.5" class="ring"></circle>
  <circle cx="20" cy="20" r="14.5" class="ring dashed"></circle>
  <path d="M20 20 A 13 13 0 0 1 33.6 27.4" class="track"></path>
  <circle cx="33.6" cy="27.4" r="1.6" class="hit"></circle>
  <text x="20" y="24.6" text-anchor="middle" class="letters">GA</text>
</svg>

<style>
  .monogram {
    overflow: visible;
  }
  .ring {
    fill: none;
    stroke: var(--art);
    stroke-width: 1.2;
  }
  .dashed {
    stroke-dasharray: 1.5 2.2;
    stroke-width: 0.9;
    opacity: 0.7;
  }
  .track {
    fill: none;
    stroke: var(--art-accent);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .hit {
    fill: var(--art-accent);
  }
  .letters {
    font-family: var(--font-head);
    font-weight: 650;
    font-size: 13px;
    fill: var(--ink);
    letter-spacing: -0.02em;
  }
</style>
