---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const rows = [16, 23.5, 31, 38.5, 46];
---

<svg class:list={['monogram', className]} viewBox="0 0 64 64" aria-hidden="true">
  <circle class="ring" cx="32" cy="32" r="28"></circle>
  <rect class="gate" x="17" y="14" width="30" height="36" rx="2"></rect>
  {
    rows.map((y) => (
      <rect class="hole" x="8.9" y={y} width="3.7" height="3.7" rx="0.45"></rect>
    ))
  }
  {
    rows.map((y, i) =>
      i === rows.length - 1 ? (
        <rect class="hole accent" x="51.4" y={y} width="3.7" height="3.7" rx="0.45"></rect>
      ) : (
        <rect class="hole" x="51.4" y={y} width="3.7" height="3.7" rx="0.45"></rect>
      ),
    )
  }
  <text class="letters" x="32" y="36" text-anchor="middle">GA</text>
</svg>

<style>
  .monogram {
    overflow: visible;
    --gate: var(--accent-2);
    --sprocket: var(--art);
    --sprocket-hit: var(--accent);
  }
  :global(:root[data-theme='dark']) .monogram {
    --gate: var(--accent);
    --sprocket-hit: var(--accent-2);
  }
  .ring {
    fill: none;
    stroke: var(--art);
    stroke-width: 1.5;
  }
  .gate {
    fill: none;
    stroke: var(--gate);
    stroke-width: 1.45;
  }
  .hole {
    fill: var(--sprocket);
  }
  .hole.accent {
    fill: var(--sprocket-hit);
  }
  .letters {
    font-family: var(--font-head);
    font-weight: 650;
    font-size: 15px;
    fill: var(--ink);
    letter-spacing: -0.03em;
  }
</style>
