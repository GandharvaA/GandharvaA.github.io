---
import type { CollectionEntry } from 'astro:content';
import { OWNER, pubStatusLabel, pubTypeLabel } from '../lib/data';

interface Props {
  pub: CollectionEntry<'publications'>;
  showAbstract?: boolean;
}
const { pub, showAbstract = false } = Astro.props;
const d = pub.data;
const status = pubStatusLabel[d.status];
const link = d.url || (d.doi ? `https://doi.org/${d.doi}` : d.arxiv ? `https://arxiv.org/abs/${d.arxiv}` : '');
---

<article class="pub">
  <p class="pub-kind label">
    <span>{pubTypeLabel[d.type]}</span>
    <span aria-hidden="true">·</span>
    <span>{d.year}</span>
    {status && <span class="tag accent">{status}</span>}
  </p>
  <h3 class="entry-title">
    {link ? <a href={link}>{d.title}</a> : d.title}
  </h3>
  <p class="authors">
    {
      d.authors.map((a, i) => (
        <>
          {a.includes(OWNER) ? <strong>{a}</strong> : a}
          {i < d.authors.length - 1 ? ', ' : ''}
        </>
      ))
    }
  </p>
  <p class="venue">{d.venue}</p>
  {d.note && <p class="note">{d.note}</p>}
  {
    showAbstract && d.abstract && (
      <details class="abstract">
        <summary>Abstract</summary>
        <p>{d.abstract}</p>
      </details>
    )
  }
  {
    (d.doi || d.arxiv) && (
      <p class="ids mono">
        {d.doi && <a href={`https://doi.org/${d.doi}`}>doi:{d.doi}</a>}
        {d.arxiv && <a href={`https://arxiv.org/abs/${d.arxiv}`}>arXiv:{d.arxiv}</a>}
      </p>
    )
  }
</article>

<style>
  .pub-kind {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
  }
  .pub-kind .tag {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .authors,
  .venue,
  .note {
    margin: 0.25rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .authors strong {
    color: var(--ink);
    font-weight: 650;
  }
  .venue {
    font-style: italic;
  }
  .abstract {
    margin-top: 0.6rem;
    font-size: var(--step--1);
  }
  .abstract summary {
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--accent-ink);
  }
  .abstract p {
    margin: 0.5rem 0 0;
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  .ids {
    display: flex;
    gap: 1rem;
    margin: 0.4rem 0 0;
    font-size: 0.76rem;
  }
</style>
