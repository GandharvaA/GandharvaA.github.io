---
interface Props {
  current: 'nerd' | 'noob';
}

const { current } = Astro.props;

const segments = [
  {
    id: 'nerd' as const,
    label: 'Nerd',
    href: '/',
    aria: 'Switch to the technical version of this site',
  },
  {
    id: 'noob' as const,
    label: 'Noob',
    href: '/plain/',
    aria: 'Switch to the noob version of this site',
  },
];
---

<div class="mode-toggle" role="group" aria-label="Explanation level">
  {
    segments.map((s) =>
      s.id === current ? (
        <span class="seg is-on" aria-current="true">{s.label}</span>
      ) : (
        <a class="seg" href={s.href} aria-label={s.aria}>
          {s.label}
        </a>
      ),
    )
  }
</div>

<style>
  .mode-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    padding: 0.15rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1;
    background: transparent;
  }
  .seg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 1.9rem;
    padding: 0 0.62rem;
    border-radius: 999px;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }
  a.seg:hover {
    color: var(--ink);
    background: var(--paper-2);
  }
  .seg.is-on {
    background: var(--ink);
    color: var(--paper);
  }
  @media (max-width: 480px) {
    .seg {
      padding: 0 0.5rem;
      min-height: 1.8rem;
    }
  }
  @media print {
    .mode-toggle {
      display: none;
    }
  }
</style>
