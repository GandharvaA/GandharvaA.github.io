---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="wrap nf blueprint">
    <svg class="nf-art draw" viewBox="0 0 320 160" aria-hidden="true">
      <path class="axis" d="M20 140H300M20 140V20" />
      <path class="bg stroke d1" pathLength="1" d="M20 120 C 90 100, 160 96, 300 92" />
      <path class="missing fade d3" d="M150 60 C 156 60, 158 96, 160 96 S 166 60, 172 60" />
      <text class="anno" x="132" y="44">expected signal</text>
      <text class="anno" x="210" y="156">m [GeV/c²]</text>
    </svg>
    <p class="label">Error 404 · no signal above background</p>
    <h1>This page is not in the data</h1>
    <p class="lede">The page you were looking for doesn’t exist or has moved.</p>
    <p><a class="btn" href="/">← Back to the start</a></p>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(3rem, 10vw, 7rem);
    text-align: left;
  }
  .nf-art {
    width: min(100%, 22rem);
    height: auto;
    margin-bottom: 1.5rem;
    fill: none;
  }
  .axis {
    stroke: var(--art);
    stroke-width: 1.2;
  }
  .bg {
    stroke: var(--art);
    stroke-width: 1.6;
  }
  .missing {
    stroke: var(--art-accent);
    stroke-width: 1.4;
    stroke-dasharray: 3 3;
  }
  .anno {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--ink-soft);
    stroke: none;
  }
</style>
