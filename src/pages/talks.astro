---
import BaseLayout from '../layouts/BaseLayout.astro';
import TalkItem from '../components/TalkItem.astro';
import { getTalks, groupByYear } from '../lib/data';

const talks = await getTalks();
const groups = [
  {
    id: 'conference',
    title: 'Conference talks',
    intro: 'Talks at international and national conferences.',
    items: talks.conference,
    compact: false,
  },
  {
    id: 'collaboration',
    title: 'Collaboration meetings',
    intro: 'Talks at HADES and CBM collaboration meetings.',
    items: talks.collaboration,
    compact: true,
  },
].filter((g) => g.items.length);
const ledeParts = [
  talks.conference.length ? `${talks.conference.length} conference talks` : '',
  talks.collaboration.length ? `${talks.collaboration.length} talks at HADES and CBM collaboration meetings` : '',
].filter(Boolean);
const lede = ledeParts.length === 2 ? `${ledeParts[0]} and ${ledeParts[1]}` : ledeParts.join('');
---

<BaseLayout title="Talks" description="Conference talks and collaboration presentations on hyperon physics with HADES and CBM.">
  <header class="page-head blueprint">
    <div class="wrap">
      <p class="eyebrow">Talks</p>
      <h1>Talks & presentations</h1>
      <p class="lede">{lede}.</p>
    </div>
  </header>

  <div class="wrap talks-page">
    {
      groups.length > 1 && (
        <fieldset class="filter no-print">
          <legend class="label">Show</legend>
          <input class="visually-hidden" type="radio" name="talk-filter" id="f-all" checked />
          <label for="f-all">All <span>{talks.all.length}</span></label>
          {talks.conference.length > 0 && (
            <>
              <input class="visually-hidden" type="radio" name="talk-filter" id="f-conference" />
              <label for="f-conference">Conference talks <span>{talks.conference.length}</span></label>
            </>
          )}
          {talks.collaboration.length > 0 && (
            <>
              <input class="visually-hidden" type="radio" name="talk-filter" id="f-collaboration" />
              <label for="f-collaboration">Collaboration <span>{talks.collaboration.length}</span></label>
            </>
          )}
        </fieldset>
      )
    }

    {
      groups.map((g) => (
        <section class:list={['group', g.id]} aria-labelledby={`${g.id}-title`}>
          <div class="group-head">
            <h2 id={`${g.id}-title`}>{g.title}</h2>
            <p>{g.intro}</p>
          </div>
          {groupByYear(g.items, (t) => t.data.date.slice(0, 4)).map(([year, items]) => (
            <div class="year-block">
              <h3 class="year mono">{year}</h3>
              <ul class="entry-list">
                {items.map((t) => (
                  <li>
                    <TalkItem talk={t} compact={g.compact} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .talks-page {
    padding-block: clamp(2rem, 5vw, 3rem);
    display: grid;
    gap: 3.5rem;
  }
  .filter {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .filter legend {
    float: left;
    margin-right: 0.6rem;
  }
  .filter label {
    cursor: pointer;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    transition: background-color 0.15s ease;
  }
  .filter label span {
    color: var(--ink-faint);
    margin-left: 0.25rem;
  }
  .filter label:hover {
    border-color: var(--ink-soft);
  }
  .filter input:checked + label {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .filter input:checked + label span {
    color: var(--paper);
    opacity: 0.7;
  }
  .filter input:focus-visible + label {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .talks-page:has(#f-conference:checked) .group.collaboration,
  .talks-page:has(#f-collaboration:checked) .group.conference {
    display: none;
  }
  .group {
    display: grid;
    gap: 1.5rem;
  }
  .group-head h2 {
    font-size: var(--step-2);
    margin-bottom: 0.3rem;
  }
  .group-head p {
    color: var(--ink-soft);
    max-width: 62ch;
    margin: 0;
  }
  .year-block {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.5rem;
  }
  .year {
    font-size: 1rem;
    font-weight: 500;
    color: var(--accent-ink);
    margin: 0;
    padding-top: 1.1rem;
    position: sticky;
    top: 5rem;
    align-self: start;
  }
  .collaboration .entry-list > li {
    padding-block: 0.8rem;
  }
  @media (max-width: 640px) {
    .year-block {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .year {
      position: static;
    }
  }
</style>
