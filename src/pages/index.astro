---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/art/HeroArt.astro';
import QuoteArt from '../components/art/QuoteArt.astro';
import Divider from '../components/art/Divider.astro';
import PublicationItem from '../components/PublicationItem.astro';
import TalkItem from '../components/TalkItem.astro';
import ResearchFigure from '../components/ResearchFigure.astro';
import { profile, settings } from '../lib/site';
import { getTalks, visible } from '../lib/data';

const pubs = (await visible('publications')).filter((p) => p.data.selected).slice(0, settings.home.selectedPublications);
const talks = await getTalks();
const selectedTalks = talks.conference.filter((t) => t.data.selected).slice(0, settings.home.selectedTalks);
const research = (await getCollection('research', (r) => !r.data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout description={profile.tagline}>
  <section class="hero blueprint">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{profile.affiliation.name} · {profile.location}</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="lede">{profile.heroStatement}</p>
        <div class="actions">
          <a class="btn primary" href="/research/">Research</a>
          <a class="btn" href="/cv/">Curriculum vitae</a>
          <a class="btn" href="/contact/">Contact</a>
        </div>
      </div>
      <figure class="hero-figure">
        <HeroArt />
        <figcaption>
          <b>Fig. 1.</b> Charged tracks bend in the magnetic field and leave hits. A Λ decays into p π⁻. The two
          candidate masses fill a two-dimensional histogram, and a fit on the mass spectrum separates the signal from the background.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="premise section blueprint" aria-labelledby="puzzle-title">
    <div class="wrap premise-grid">
      <figure class="premise-figure">
        <QuoteArt />
        <figcaption>
          Schematic. Two pπ⁻ masses meet at the ΛΛ signal. The potential between the Λs falls below the
          line of no interaction, and that attraction changes the mass a neutron star can support. The
          upper star meets the observed mass. The lower curve turns over beneath it.
        </figcaption>
      </figure>
      <div class="premise-text">
        <p class="eyebrow">Neutron stars</p>
        <h2 id="puzzle-title">The hyperon puzzle</h2>
        <p class="lede">
          The core of a neutron star is dense enough for hyperons to appear. Those strange particles
          soften the matter, so the star can support less mass. The heaviest stars we observe still
          stand. That tension is the hyperon puzzle.
        </p>
        <p class="lede">
          The ΛΛ attraction in the drawing is one piece of it. The two masses are the signal, the well
          is the force between the Λs, and the curves are the mass a star can support.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="work-title">What I do</h2>
        <p>{profile.work.intro}</p>
      </div>
      <ol class="work-list">
        {
          profile.work.items.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="wrap"><Divider label="Research" /></div>

  <section class="section research" aria-labelledby="research-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Research</p>
        <h2 id="research-title">Strange matter, measured carefully</h2>
        <p>
          How do hyperons (particles containing a strange quark) interact? The answer shapes our picture of neutron
          stars. I study this with data from the HADES experiment and with simulations for CBM at FAIR.
        </p>
      </div>
      <div class="research-grid">
        <ResearchFigure name="hades" class="research-fig" caption="<b>Fig. 2.</b> Schematic of HADES with its forward detector and a ΛΛ event." />
        <ol class="research-list" role="list">
          {
            research.map((r) => (
              <li>
                <p class="label">{r.data.kicker}</p>
                <h3><a href={`/research/${r.id}/`}>{r.data.title}</a></h3>
                <p>{r.data.summary}</p>
                <a class="more mono" href={`/research/${r.id}/`} aria-label={`Read more: ${r.data.title}`}>Read the project →</a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section selected" aria-labelledby="selected-title">
    <div class="wrap">
      <h2 id="selected-title" class="visually-hidden">Selected publications and talks</h2>
      <div class="two-col">
        <div>
          <div class="col-head">
            <h3 class="label">Selected publications</h3>
            <a class="mono small" href="/publications/">All publications →</a>
          </div>
          <ul class="entry-list">{pubs.map((p) => <li><PublicationItem pub={p} /></li>)}</ul>
        </div>
        <div>
          <div class="col-head">
            <h3 class="label">Recent talks</h3>
            <a class="mono small" href="/talks/">All talks →</a>
          </div>
          <ul class="entry-list">{selectedTalks.map((t) => <li><TalkItem talk={t} /></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section cta" aria-labelledby="cta-title">
    <div class="wrap">
      <div class="cta-box blueprint">
        <div>
          <h2 id="cta-title">Curriculum vitae</h2>
          <p>
            {
              settings.showIndustry
                ? 'A one-page industry CV, a two-page industry CV, and a full academic CV.'
                : 'A full academic CV, and an online overview of experience, publications and teaching.'
            }
          </p>
        </div>
        <div class="actions">
          {
            settings.showIndustry && (
              <>
                <a class="btn primary" href="/cv/cv-industry-1p.pdf" download>Industry CV · 1 page</a>
                <a class="btn" href="/cv/cv-industry.pdf" download>Industry CV · 2 pages</a>
              </>
            )
          }
          <a class="btn primary" href="/cv/cv-academic.pdf" download>Academic CV · PDF</a>
          <a class="btn" href="/cv/">View online</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 5rem) 2.5rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero h1 {
    margin-bottom: 0.15em;
  }
  .role {
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 0.78rem + 0.25vw, 0.98rem);
    letter-spacing: 0.04em;
    color: var(--accent-ink);
    margin-bottom: 1.4rem;
  }
  .hero .lede {
    color: var(--ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.8rem;
  }
  .hero-figure figcaption {
    max-width: 60ch;
  }

  .premise {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .premise-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .premise-figure figcaption {
    max-width: 62ch;
  }
  .premise-text .lede {
    color: var(--ink);
  }
  .premise-text .lede + .lede {
    color: var(--ink-soft);
  }

  .work-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem 2.5rem;
  }
  .work-list li {
    margin: 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--accent);
  }
  .work-list li:nth-child(even) {
    border-left-color: var(--accent-2);
  }
  .work-list h3 {
    margin: 0 0 0.35rem;
    font-size: var(--step-1);
  }
  .work-list p {
    margin: 0;
    color: var(--ink-soft);
  }

  .research-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .research-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2rem;
  }
  .research-list li {
    margin: 0;
    padding-left: 1.2rem;
    border-left: 2px solid var(--accent);
  }
  .research-list li + li {
    border-left-color: var(--accent-2);
  }
  .research-list h3 {
    margin: 0.35rem 0 0.5rem;
  }
  .research-list h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .research-list h3 a:hover {
    text-decoration: underline;
  }
  .research-list p:not(.label) {
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }
  .more {
    font-size: 0.8rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .col-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.8rem;
  }
  .col-head h3 {
    margin: 0;
  }

  .cta-box {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: center;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background-color: var(--paper-2);
  }
  .cta-box h2 {
    font-size: var(--step-2);
  }
  .cta-box p {
    color: var(--ink-soft);
    margin: 0;
  }
  .cta-box .actions {
    margin: 0;
    justify-content: flex-end;
  }

  @media (max-width: 980px) {
    .hero-grid,
    .premise-grid,
    .research-grid,
    .cta-box {
      grid-template-columns: 1fr;
    }
    .work-list {
      grid-template-columns: 1fr;
    }
    .cta-box .actions {
      justify-content: flex-start;
    }
  }
  @media (max-width: 720px) {
    .premise-grid,
    .two-col {
      grid-template-columns: 1fr;
    }
    .work-list {
      grid-template-columns: 1fr;
    }
  }
</style>
