---
import BaseLayout from '../layouts/BaseLayout.astro';
import Divider from '../components/art/Divider.astro';
import Monogram from '../components/art/Monogram.astro';
import { profile, photographyUrl } from '../lib/site';
import { formatDate, formatRange, visible, yearRange } from '../lib/data';

const [education, teaching, service, training] = await Promise.all([
  visible('education'),
  visible('teaching'),
  visible('service'),
  visible('training'),
]);
const leadership = service.filter((s) => ['leadership', 'committee', 'mentoring'].includes(s.data.category));
const labs = service.filter((s) => s.data.category === 'lab');
const courses = teaching.filter((t) => t.data.kind !== 'training');
const teacherTraining = teaching.filter((t) => t.data.kind === 'training');
---

<BaseLayout title="About" description="About Gandharva Appagere: experimental physicist, teacher and PhD-council chair at Stockholm University." type="profile">
  <header class="page-head blueprint">
    <div class="wrap head">
      <div>
        <p class="eyebrow">About</p>
        <h1>Physicist, engineer, organiser</h1>
        <p class="lede">{profile.tagline}</p>
      </div>
      <Monogram class="about-mark" />
    </div>
  </header>

  <div class="wrap about">
    <section class="bio prose" aria-label="Biography">
      {profile.bio.map((p, i) => <p class:list={{ first: i === 0 }}>{p}</p>)}
    </section>

    <Divider />

    <div class="cols">
      <section aria-labelledby="edu">
        <h2 id="edu">Education</h2>
        <ol class="plain">
          {
            education.map((e) => (
              <li>
                <p class="label">{formatRange(e.data.start, e.data.end, e.data.expected)}</p>
                <p class="item-title">
                  {e.data.degree}, {e.data.field}
                </p>
                <p class="item-meta">{e.data.institution}</p>
                {e.data.details.slice(0, 1).map((d) => (
                  <p class="item-desc">{d}</p>
                ))}
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="lead">
        <h2 id="lead">Leadership</h2>
        <ol class="plain">
          {
            leadership.map((s) => (
              <li>
                <p class="label">{yearRange(s.data.start, s.data.end)}</p>
                <p class="item-title">{s.data.role}</p>
                <p class="item-meta">{s.data.organisation}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    {
      labs.length > 0 && (
        <section aria-labelledby="lab" class="block">
          <h2 id="lab">Laboratory</h2>
          <p class="intro">
            Lab responsible for the nuclear physics student laboratory at Fysikum, 2021–2025.
          </p>
          <ul class="teach-grid">
            {labs.map((s) => (
              <li class="card">
                <p class="label">{yearRange(s.data.start, s.data.end)}</p>
                <p class="item-title">{s.data.role}</p>
                <p class="item-meta">{s.data.organisation}</p>
                {s.data.description && <p class="item-desc">{s.data.description}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="teach" class="block">
      <h2 id="teach">Teaching</h2>
      <p class="intro">
        Teaching assistant at Fysikum since 2021. The responsibility covers laboratory teaching and also
        lectures and tutorials.
      </p>
      <ul class="teach-grid">
        {
          courses.map((t) => (
            <li class="card">
              <p class="label">
                {t.data.code || (t.data.kind === 'supervision' ? 'Supervision' : 'Course')} · {t.data.terms.join(', ')}
              </p>
              <p class="item-title">{t.data.course}</p>
              <p class="item-desc">{t.data.role}</p>
            </li>
          ))
        }
      </ul>
      {
        teacherTraining.length > 0 && (
          <p class="item-desc training">
            Teacher training: {teacherTraining.map((t) => `${t.data.course} (${t.data.terms.join(', ')})`).join('; ')}.
          </p>
        )
      }
    </section>

    <section aria-labelledby="schools" class="block">
      <h2 id="schools">Beam times, schools & visits</h2>
      <ol class="plain compact spread">
        {
          training.map((t) => (
            <li>
              <span class="label">{/^\d{4}-\d{2}$/.test(t.data.date) ? formatDate(t.data.date) : t.data.date}</span>
              <span class="item-title">{t.data.title}</span>
              {t.data.location && <span class="item-meta"> · {t.data.location}</span>}
            </li>
          ))
        }
      </ol>
    </section>
    {
      photographyUrl && (
        <section aria-labelledby="beyond" class="beyond card">
          <h2 id="beyond">Beyond the lab</h2>
          <p class="item-desc">
            When I am not chasing hyperons I take photographs, a different way of paying attention to light.
          </p>
          <a class="btn" href={photographyUrl} rel="me noopener">
            See my photography →
          </a>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
  }
  .head :global(.about-mark) {
    width: clamp(6.5rem, 18vw, 11.5rem);
    height: auto;
  }
  .about {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .bio p {
    font-size: var(--step-0);
  }
  .bio .first::first-letter {
    font-family: var(--font-head);
    float: left;
    font-size: 3.4em;
    line-height: 0.85;
    padding: 0.08em 0.1em 0 0;
    color: var(--accent);
  }
  h2 {
    font-size: var(--step-2);
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .cols > div {
    display: grid;
    gap: 2.5rem;
    align-content: start;
  }
  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.2rem;
  }
  .plain li {
    margin: 0;
  }
  .plain.compact {
    gap: 0.8rem;
    font-size: var(--step--1);
  }
  .plain.compact li {
    display: grid;
    gap: 0.1rem;
  }
  .plain.compact.spread {
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(2rem, 5vw, 4rem);
  }
  .plain.compact .item-title {
    font-family: var(--font-body);
    font-size: var(--step--1);
  }
  .plain p {
    margin: 0;
  }
  .item-title {
    font-family: var(--font-head);
    font-weight: 560;
    font-size: 1.05rem;
    margin: 0.15rem 0 0;
  }
  .item-meta,
  .item-desc {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .item-desc {
    margin-top: 0.25rem;
  }
  .block .intro {
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .teach-grid {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
  }
  .teach-grid li {
    margin: 0;
    box-shadow: none;
    padding: 1.1rem 1.2rem;
  }
  .teach-grid p {
    margin: 0;
  }
  .training {
    margin-top: 1.2rem;
  }
  .beyond {
    background: var(--paper-2);
  }
  .beyond h2 {
    font-size: var(--step-1);
  }
  @media (max-width: 820px) {
    .cols,
    .plain.compact.spread {
      grid-template-columns: 1fr;
    }
  }
</style>
